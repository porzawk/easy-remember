# ===== Database (Neon Postgres) =====
# เอามาจาก https://console.neon.tech/ -> Connection string (pooled)
DATABASE_URL="postgresql://user:password@ep-xxx.neon.tech/easyremember?sslmode=require"

# ===== Auth.js (NextAuth) =====
# สร้างค่าสุ่ม: รันคำสั่ง  npx auth secret  หรือ  openssl rand -base64 32
AUTH_SECRET="change-me-to-a-random-string"
# ตอน dev ใช้ http://localhost:3000 ; ตอน deploy ใส่ domain จริง
AUTH_URL="http://localhost:3000"

# Google OAuth -> https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ===== AI สำหรับสร้างคำแปล/ประโยคตัวอย่าง (OpenAI-compatible) =====
# ค่า default ใช้ Groq ซึ่งมี free tier (ไม่ต้องผูกบัตร)
# สมัคร + สร้าง API key ฟรีที่ https://console.groq.com/keys
AI_API_KEY=""
AI_BASE_URL="https://api.groq.com/openai/v1"
AI_MODEL="llama-3.3-70b-versatile"

# --- ทางเลือกอื่น (ถ้าจะใช้แทน Groq ก็แก้ 3 ค่าข้างบน) ---
# Google Gemini (ฟรี): https://aistudio.google.com/apikey
#   AI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
#   AI_MODEL="gemini-2.0-flash"
# Z.ai (ต้องมีเครดิต): https://z.ai/
#   AI_BASE_URL="https://api.z.ai/api/paas/v4"
#   AI_MODEL="glm-4.6"
